          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('General safety request is allowed', () => pm.expect(pm.response.json().recommendedAction).to.eql('ALLOW'));" ] } }]
