    {
      "name": "Phase 26 - Self-Harm and Crisis Handling",
      "item": [
        {
          "name": "General wellbeing support is allowed",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"Explain general wellbeing support resources.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/detect/content-safety" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('General wellbeing request is allowed', () => pm.expect(pm.response.json().recommendedAction).to.eql('ALLOW'));", "pm.test('No safety category matched', () => pm.expect(pm.response.json().matched).to.eql(false));" ] } }]
        }
      ]
    },
    {
      "name": "Phase 27 - Standalone End-to-End Regression",
      "item": [
        {
          "name": "Authenticated safe input is normalized and allowed",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Correlation-ID", "value": "postman-phase27-001" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"Summarize the approved product documentation.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/v1/moderate" },
