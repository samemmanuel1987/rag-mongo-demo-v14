          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Health education is allowed', () => pm.expect(pm.response.json().recommendedAction).to.eql('ALLOW'));", "pm.test('No safety category matched', () => pm.expect(pm.response.json().matched).to.eql(false));" ] } }]
